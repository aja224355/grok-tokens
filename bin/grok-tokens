#!/usr/bin/env bash
ROOT="$(cd "$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")/.." && pwd)"
if [[ -x "$ROOT/target/release/grok-tokens" ]]; then
  exec "$ROOT/target/release/grok-tokens" "$@"
fi
if command -v cargo >/dev/null 2>&1 && [[ -f "$ROOT/Cargo.toml" ]]; then
  exec cargo run --quiet --manifest-path "$ROOT/Cargo.toml" --release -- "$@"
fi
exec python3 "$ROOT/grok_tokens.py" "$@"
